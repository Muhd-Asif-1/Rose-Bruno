meta {
  name: Get Credits
  type: http
  seq: 3
}

get {
  url: {{oursmsBaseUrl}}/billing/credits
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{oursmsApiKey}}
}

tests {
  test("returns the available credit balance", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()?.credits).to.be.a("number");
  });
}
