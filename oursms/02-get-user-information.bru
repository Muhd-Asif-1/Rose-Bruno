meta {
  name: Get User Information
  type: http
  seq: 2
}

get {
  url: {{oursmsBaseUrl}}/users/me
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{oursmsApiKey}}
}

tests {
  test("accepts the configured API key", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()?.userId).to.be.a("string");
  });
}
