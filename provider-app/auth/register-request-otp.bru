meta {
  name: Register Request OTP
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/app/provider/auth/register/request-otp
  body: multipartForm
  auth: none
}

headers {
}

body:multipart-form {
  phone.phoneCode: {{phoneCode}}
  phone.phoneNumber: {{phoneNumber}}
  fullName: {{fullName}}
  bio: {{providerBio}}
  gender: 2
  startingPrice: 250
  location.address: {{providerAddress}}
  location.latitude: {{providerLatitude}}
  location.longitude: {{providerLongitude}}
  specialties[]: {{specialtyId}}
  specialties[]: 6a61e8e42f733dcbd4f45c36
  specialties[]: 6a62fb1f876d0bc402ea3b6e
  displayImage: @file({{displayImagePath}})
}

script:post-response {
  const data = res.getBody()?.data;
  
  if (data?.sessionToken) {
    bru.setVar("sessionToken", data.sessionToken);
  }
  
  if (data?.otp) {
    bru.setVar("otp", data.otp);
  }
}
