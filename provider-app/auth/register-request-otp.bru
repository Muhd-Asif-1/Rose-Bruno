meta {
  name: Register Request OTP
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/app/provider/auth/register/request-otp
  body: multipartForm
  auth: none
}

headers {
}

body:multipart-form {
  phone.phoneCode: {{providerRegistrationPhoneCode}}
  phone.phoneNumber: {{providerRegistrationPhoneNumber}}
  fullName: {{fullName}}
  bio: {{providerBio}}
  gender: {{providerGender}}
  startingPrice: {{providerStartingPrice}}
  location.address: {{providerAddress}}
  location.latitude: {{providerLatitude}}
  location.longitude: {{providerLongitude}}
  specialties[]: {{specialtyId}}
  displayImage: @file({{displayImagePath}})
}

script:post-response {
  const data = res.getBody()?.data;
  
  if (data?.sessionToken) {
    bru.setVar("providerSessionToken", data.sessionToken);
  }
  
  if (data?.otp) {
    bru.setVar("providerOtp", data.otp);
  }
}
