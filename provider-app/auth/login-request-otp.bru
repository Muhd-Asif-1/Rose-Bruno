meta {
  name: Login Request OTP
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/app/provider/auth/login/request-otp
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "phone": {
      "phoneCode": "{{providerPhoneCode}}",
      "phoneNumber": "{{providerPhoneNumber}}"
    }
  }
}

script:post-response {
  const data = res.getBody()?.data;
  
  if (data?.sessionToken) {
    bru.setVar("providerSessionToken", data.sessionToken);
  }
  
  if (data?.otp) {
    bru.setVar("providerOtp", data.otp);
  }
}
