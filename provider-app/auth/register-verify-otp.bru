meta {
  name: Register Verify OTP
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/app/provider/auth/register/verify-otp
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  sessionToken: {{providerSessionToken}}
}

body:json {
  {
    "otp": "{{providerOtp}}"
  }
}

script:post-response {
  const data = res.getBody()?.data;
  
  if (data?.sessionToken) {
    bru.setVar("providerSessionToken", data.sessionToken);
  }
}
