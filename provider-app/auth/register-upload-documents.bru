meta {
  name: Register Upload Documents
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/app/provider/auth/register/upload-documents
  body: multipartForm
  auth: none
}

headers {
  sessionToken: {{providerSessionToken}}
}

body:multipart-form {
  nationalId[]: @file({{nationalIdFrontPath}})
  nationalId[]: @file({{nationalIdBackPath}})
  selfieVerification: @file({{selfieVerificationPath}})
}
