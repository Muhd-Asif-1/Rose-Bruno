meta {
  name: Update Booking Request Status
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/app/provider/bookings/{{bookingId}}/status
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{providerAccessToken}}
  Content-Type: application/json
}

body:json {
  {
    "status": "{{providerBookingRequestStatus}}"
  }
}
