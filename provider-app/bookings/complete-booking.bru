meta {
  name: Complete Booking
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/app/provider/bookings/{{bookingId}}/complete
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{providerAccessToken}}
  Content-Type: application/json
}

body:json {
  {
    "otp": "{{bookingCompletionOtp}}"
  }
}
