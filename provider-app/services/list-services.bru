meta {
  name: List Services
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/app/provider/services?page=1&pageSize=15&q=&locale={{locale}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{providerAccessToken}}
}

script:post-response {
  const services = res.getBody()?.data?.items;
  
  if (Array.isArray(services) && services[0]?._id) {
    bru.setVar("serviceId", services[0]._id);
  }
}
