meta {
  name: Upload Document
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/app/provider/documents
  body: multipartForm
  auth: none
}

headers {
  Authorization: Bearer {{providerAccessToken}}
}

body:multipart-form {
  name: {{providerDocumentName}}
  file: @file({{providerDocumentImagePath}})
}
