meta {
  name: List Providers - Alternate Current Location
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/app/customer/explore/providers?page=1&pageSize=15&sortBy=2&maxDistance=10&address={{bookingCustomAddress}}&latitude={{bookingCustomLatitude}}&longitude={{bookingCustomLongitude}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{customerAccessToken}}
}
