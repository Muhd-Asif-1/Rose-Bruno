meta {
  name: List Providers
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/app/customer/explore/providers?page=1&pageSize=15&search=&categoryId={{specialtyId}}&gender=&sortBy=1&maxDistance=10&minRating=4
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{customerAccessToken}}
}

script:post-response {
  const providers = res.getBody()?.data?.providers;

  if (Array.isArray(providers) && providers[0]?.providerId) {
    bru.setVar("providerId", providers[0].providerId);
  }
}
