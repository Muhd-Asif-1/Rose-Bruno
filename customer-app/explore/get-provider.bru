meta {
  name: Get Provider
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/app/customer/explore/providers/{{providerId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{customerAccessToken}}
}

script:post-response {
  const provider = res.getBody()?.data?.provider;

  if (provider?.providerId) {
    bru.setVar("providerId", provider.providerId);
  }

  if (Array.isArray(provider?.services) && provider.services[0]?._id) {
    const firstService = provider.services[0];
    const secondService = provider.services.find(
      (service) =>
        service._id !== firstService._id &&
        service.categoryId === firstService.categoryId
    );

    bru.setVar("serviceId", firstService._id);
    bru.setVar("secondServiceId", secondService?._id ?? "");
  }
}
