meta {
  name: Get Provider
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/app/customer/explore/providers/{{providerId}}?address={{customerHomeAddress}}&latitude={{customerHomeLatitude}}&longitude={{customerHomeLongitude}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{customerAccessToken}}
}

script:post-response {
  const provider = res.getBody()?.data?.provider;

  if (Array.isArray(provider?.services) && provider.services.length > 0) {
    // serviceId stays a plain, user-editable environment variable (like
    // providerId) instead of a script-owned runtime variable. If it already
    // points at one of this provider's services, keep it and just look up a
    // different-service match for secondServiceId; otherwise fall back to the
    // first service for that lookup only.
    const currentServiceId = bru.getVar("serviceId");
    const referenceService = provider.services.find((service) => service._id === currentServiceId) ?? provider.services[0];
    const secondService = provider.services.find((service) => service._id !== referenceService._id);

    bru.setVar("secondServiceId", secondService?._id ?? "");
  }
}
