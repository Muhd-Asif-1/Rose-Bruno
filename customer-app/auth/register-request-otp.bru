meta {
  name: Register Request OTP
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/app/customer/auth/register/request-otp
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "fullName": "{{fullName}}",
    "phone": {
      "phoneCode": "{{phoneCode}}",
      "phoneNumber": "{{phoneNumber}}"
    },
    "email": "{{email}}",
    "gender": {{gender}}
  }
}

script:post-response {
  const data = res.getBody()?.data;
  
  if (data?.sessionToken) {
    bru.setVar("sessionToken", data.sessionToken);
  }
  
  if (data?.otp) {
    bru.setVar("otp", data.otp);
  }
}
