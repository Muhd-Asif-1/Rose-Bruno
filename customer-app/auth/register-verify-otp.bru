meta {
  name: Register Verify OTP
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/app/customer/auth/register/verify-otp
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  sessionToken: {{customerSessionToken}}
}

body:json {
  {
    "otp": "{{customerOtp}}"
  }
}

script:post-response {
  const data = res.getBody()?.data;
  
  if (data?.accessToken) {
    bru.setVar("customerAccessToken", data.accessToken);
  }
}
