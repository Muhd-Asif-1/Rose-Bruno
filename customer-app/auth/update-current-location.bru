meta {
  name: Update Current Location
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/app/customer/auth/current-location
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{customerAccessToken}}
  Content-Type: application/json
}

body:json {
  {
    "location": {
      "address": "{{customerHomeAddress}}",
      "latitude": {{customerHomeLatitude}},
      "longitude": {{customerHomeLongitude}}
    }
  }
}
