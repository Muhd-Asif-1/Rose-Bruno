meta {
  name: Create Review
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/app/customer/reviews
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{customerAccessToken}}
  Content-Type: application/json
}

body:json {
  {
    "bookingId": "{{bookingId}}",
    "rating": {{reviewRating}},
    "review": "{{reviewText}}"
  }
}

script:post-response {
  const review = res.getBody()?.data?.review;

  if (review?._id) {
    bru.setVar("reviewId", review._id);
  }
}
