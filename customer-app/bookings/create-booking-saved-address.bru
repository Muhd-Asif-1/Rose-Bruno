meta {
  name: Create Booking - Saved Address
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/app/customer/bookings
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{customerAccessToken}}
  Content-Type: application/json
}

body:json {
  {
    "providerId": "{{providerId}}",
    "serviceIds": [
      "{{serviceId}}",
      "{{secondServiceId}}"
    ],
    "scheduledAt": "{{bookingScheduledAt}}",
    "specialInstructions": "{{bookingSpecialInstructions}}",
    "location": {
      "type": "saved_address",
      "addressId": "{{addressId}}"
    }
  }
}

script:post-response {
  const payment = res.getBody()?.data;

  if (payment?.paymentIntentId) {
    bru.setVar("paymentIntentId", payment.paymentIntentId);
  }

  if (payment?.checkoutUrl) {
    bru.setVar("checkoutUrl", payment.checkoutUrl);
  }
}
