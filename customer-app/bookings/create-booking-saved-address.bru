meta {
  name: Create Booking - Saved Address
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/app/customer/bookings
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{customerAccessToken}}
  Content-Type: application/json
}

body:json {
  {
    "providerId": "{{providerId}}",
    "serviceId": "{{serviceId}}",
    "scheduledAt": "{{bookingScheduledAt}}",
    "specialInstructions": "{{bookingSpecialInstructions}}",
    "location": {
      "type": "saved_address",
      "addressId": "{{addressId}}"
    }
  }
}

script:post-response {
  const booking = res.getBody()?.data?.booking;

  if (booking?._id) {
    bru.setVar("bookingId", booking._id);
  }
}
