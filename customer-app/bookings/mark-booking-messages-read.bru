meta {
  name: Mark Booking Messages Read
  type: http
  seq: 9
}

patch {
  url: {{baseUrl}}/app/customer/bookings/{{bookingId}}/messages/read
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{customerAccessToken}}
  Content-Type: application/json
}

body:json {
  {
    "throughMessageId": "{{chatMessageId}}"
  }
}
