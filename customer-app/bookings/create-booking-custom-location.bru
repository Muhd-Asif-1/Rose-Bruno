meta {
  name: Create Booking - Custom Location
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/app/customer/bookings
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{customerAccessToken}}
  Content-Type: application/json
}

body:json {
  {
    "providerId": "{{providerId}}",
    "serviceIds": [
      "{{serviceId}}",
      "{{secondServiceId}}"
    ],
    "scheduledAt": "{{customBookingScheduledAt}}",
    "specialInstructions": "{{bookingSpecialInstructions}}",
    "location": {
      "type": "custom",
      "address": "{{bookingCustomAddress}}",
      "latitude": {{bookingCustomLatitude}},
      "longitude": {{bookingCustomLongitude}}
    }
  }
}

script:post-response {
  const payment = res.getBody()?.data;

  if (payment?.paymentIntentId) {
    bru.setVar("paymentIntentId", payment.paymentIntentId);
  }

  if (payment?.checkoutUrl) {
    bru.setVar("checkoutUrl", payment.checkoutUrl);
  }
}
