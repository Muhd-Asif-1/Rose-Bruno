meta {
  name: Send Image Message
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/app/customer/bookings/{{bookingId}}/messages
  body: multipartForm
  auth: none
}

headers {
  Authorization: Bearer {{customerAccessToken}}
}

body:multipart-form {
  clientMessageId: {{customerChatImageClientMessageId}}
  type: image
  caption: {{chatCaption}}
  image: @file({{chatImagePath}})
}

script:post-response {
  const message = res.getBody()?.data?.message;
  if (message?._id) {
    bru.setVar("chatMessageId", message._id);
    bru.setVar("chatImageMessageId", message._id);
  }
}
