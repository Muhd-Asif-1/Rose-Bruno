meta {
  name: Update Address
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/app/customer/addresses/{{addressId}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{customerAccessToken}}
  Content-Type: application/json
}

body:json {
  {
    "label": 2,
    "address": "King Fahd Road, Al Olaya, Riyadh",
    "city": "Riyadh",
    "latitude": 24.7118,
    "longitude": 46.6744
  }
}
