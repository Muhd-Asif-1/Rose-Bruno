meta {
  name: Update Address
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/app/customer/addresses/{{addressId}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{customerAccessToken}}
  Content-Type: application/json
}

body:json {
  {
    "label": 2,
    "street": "456 King Fahd Road",
    "city": "Jeddah"
  }
}
