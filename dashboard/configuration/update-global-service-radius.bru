meta {
  name: Update Global Service Radius
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/admin/configuration
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{adminAccessToken}}
  Content-Type: application/json
}

body:json {
  {
    "globalServiceRadius": {{globalServiceRadius}}
  }
}
