meta {
  name: Reject Provider
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/admin/providers/{{providerId}}/verification-status
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{adminAccessToken}}
}

body:json {
  {
    "verificationStatus": 2,
    "rejectionReason": "The submitted identity document is not readable."
  }
}
